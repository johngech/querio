generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Org {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  age       Int
  status    String
  role      String
  createdAt DateTime @default(now())
  orgId     Int?
  org       Org?     @relation(fields: [orgId], references: [id])

  @@index([orgId])
}
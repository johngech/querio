{
  "name": "@queryjs/example-express-typeorm",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "QueryJS + Express + TypeORM (sql.js/SQLite) example server",
  "scripts": {
    "seed": "bun run src/seed.ts",
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun run typecheck"
  },
  "dependencies": {
    "@queryjs/core": "file:../../packages/core",
    "@queryjs/typeorm": "file:../../packages/typeorm",
    "express": "^5.2.1",
    "reflect-metadata": "^0.2.2",
    "sql.js": "^1.14.2",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/express": "^5.0.6",
    "typescript": "^7.0.2"
  }
}

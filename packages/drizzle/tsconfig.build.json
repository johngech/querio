{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "paths": {
      "@queryjs/core": ["../core/dist"],
      "@queryjs/core/*": ["../core/dist/*"]
    }
  },
  "include": ["src"],
  "exclude": ["tests", "**/*.spec.ts", "node_modules", "dist"]
}

{
  "name": "@queryjs/typeorm",
  "version": "0.1.0",
  "description": "TypeORM adapter for QueryJS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/johngech/querio.git"
  },
  "author": "Yohannes Getachew <yohngech@gmail.com>",
  "bugs": {
    "url": "https://github.com/johngech/querio/issues"
  },
  "homepage": "https://github.com/johngech/querio#readme",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@queryjs/core": "^0.1.0",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typeorm": "^0.3.24",
    "typescript": "^7.0.0"
  },
  "keywords": [
    "querio",
    "typeorm",
    "orm",
    "adapter"
  ]
}

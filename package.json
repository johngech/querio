{
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "name": "querio-monorepo",
  "scripts": {
    "build": "bun run build.ts",
    "test": "bun test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/bun": "^1.3.14",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "typeorm": "^0.3.24",
    "typescript": "^7.0.0"
  },
  "lint-staged": {
    "*.{ts,js,json}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
